<?xml version="1.0" encoding="UTF-8"?>
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="omg_shared_ca_permissions.xsd">
  <permissions>

    <!-- SERVER: publishes responses/positions, subscribes to requests/input -->
    <grant name="server_permissions">
      <subject_name>CN=server,O=CSD3116Project</subject_name>
      <validity>
        <not_before>2026-01-01T00:00:00</not_before>
        <not_after>2030-01-01T00:00:00</not_after>
      </validity>
      <allow_rule>
        <domains><id>0</id></domains>
        <publish>
          <topics>
            <topic>JoinResponse</topic>
            <topic>Position</topic>
          </topics>
        </publish>
        <subscribe>
          <topics>
            <topic>JoinRequest</topic>
            <topic>LeaveRequest</topic>
            <topic>Input</topic>
          </topics>
        </subscribe>
      </allow_rule>
      <!-- Drifto (net/): api_server + game_server (domains 1..30) -->
      <allow_rule>
        <domains><id_range><min>1</min><max>30</max></id_range></domains>
        <publish>
          <topics><topic>Drifto_*_Dn</topic><topic>Drifto_Gs*</topic></topics>
          <partitions><partition>*</partition></partitions>
        </publish>
        <subscribe>
          <topics><topic>Drifto_*_Up</topic><topic>Drifto_Gs*</topic></topics>
          <partitions><partition>*</partition></partitions>
        </subscribe>
      </allow_rule>
      <default>DENY</default>
    </grant>

    <!-- CLIENT 1: publishes requests/input, subscribes to responses/positions -->
    <grant name="client1_permissions">
      <subject_name>CN=client1,O=CSD3116Project</subject_name>
      <validity>
        <not_before>2026-01-01T00:00:00</not_before>
        <not_after>2030-01-01T00:00:00</not_after>
      </validity>
      <allow_rule>
        <domains><id>0</id></domains>
        <publish>
          <topics>
            <topic>JoinRequest</topic>
            <topic>LeaveRequest</topic>
            <topic>Input</topic>
          </topics>
        </publish>
        <subscribe>
          <topics>
            <topic>JoinResponse</topic>
            <topic>Position</topic>
          </topics>
        </subscribe>
      </allow_rule>
      <!-- Drifto (net/): API + game service domains 1..30. Clients only ever
           write *_Up topics and read *_Dn topics, so they can never read
           each other's traffic directly. -->
      <allow_rule>
        <domains><id_range><min>1</min><max>30</max></id_range></domains>
        <publish>
          <topics><topic>Drifto_*_Up</topic></topics>
          <partitions><partition>*</partition></partitions>
        </publish>
        <subscribe>
          <topics><topic>Drifto_*_Dn</topic></topics>
          <partitions><partition>*</partition></partitions>
        </subscribe>
      </allow_rule>
      <!-- Drifto LAN mode (net/src/net_lan.cpp): serverless rooms in domain 10.
           Every client is potentially the host, so it both publishes and
           subscribes all Drifto_Lan_* topics. -->
      <allow_rule>
        <domains><id>10</id></domains>
        <publish>
          <topics><topic>Drifto_Lan_*</topic></topics>
          <partitions><partition>*</partition></partitions>
        </publish>
        <subscribe>
          <topics><topic>Drifto_Lan_*</topic></topics>
          <partitions><partition>*</partition></partitions>
        </subscribe>
      </allow_rule>
      <default>DENY</default>
    </grant>

